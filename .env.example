# PostgreSQL (Role khusus plas_api tanpa BYPASSRLS untuk runtime Next.js REST API)
DATABASE_URL=postgresql://plas_api:CHANGE_ME@127.0.0.1:5432/postgres

# PostgreSQL Admin (khusus scripts/migrate.mjs dan scripts/regress.mjs, JANGAN dipakai runtime request)
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Supabase Auth (hanya untuk Auth/verifikasi JWT, bukan akses tabel langsung)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# AI Learning Assistant (AI_PROVIDER: gemini | groq | mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
AI_PENDING_TIMEOUT_MINUTES=5
